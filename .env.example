# Game Engine PostgreSQL
GAME_ENGINE_DB_HOST=localhost
GAME_ENGINE_DB_PORT=5432
GAME_ENGINE_DB_NAME=leds_game_engine
GAME_ENGINE_DB_USER=postgres
GAME_ENGINE_DB_PASSWORD=postgres

# Player PostgreSQL
PLAYER_DB_HOST=localhost
PLAYER_DB_PORT=5433
PLAYER_DB_NAME=leds_player
PLAYER_DB_USER=postgres
PLAYER_DB_PASSWORD=postgres

# Catalog PostgreSQL
CATALOG_DB_HOST=localhost
CATALOG_DB_PORT=5434
CATALOG_DB_NAME=leds_catalog
CATALOG_DB_USER=postgres
CATALOG_DB_PASSWORD=postgres
# Design-time / runtime override for the Catalog EF connection string.
CATALOG_DB_CONNECTION_STRING=Host=localhost;Port=5434;Database=leds_catalog;Username=postgres;Password=postgres

# API URLs
GAME_ENGINE_API_URL=http://localhost:5187
CATALOG_API_URL=http://localhost:5193
PLAYER_API_URL=http://localhost:5189
WEB_CLIENT_URL=http://localhost:5173

# Game Engine dev-only tools (disabled by default; local-only token)
GAME_ENGINE_DEVTOOLS_ENABLED=true
GAME_ENGINE_DEVTOOLS_TOKEN=devtools

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Leds.GameEngine.Domain\Leds.GameEngine.Domain.csproj" />
    <ProjectReference Include="..\..\src\Leds.GameEngine.Application\Leds.GameEngine.Application.csproj" />
    <ProjectReference Include="..\..\src\Leds.GameEngine.Infrastructure\Leds.GameEngine.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Historical continuous-time combat specifications were retired with the
         tactical-only runtime. Tactical tests remain compiled below by default. -->
    <Compile Remove="Combats\Actions\**\*.cs" />
    <Compile Remove="Combats\SubmitCombatAction\**\*.cs" />
    <Compile Remove="Combats\Targeting\**\*.cs" />
    <Compile Remove="Combats\EnemyTurns\EnemyCombatTurnResolverTests.cs" />
    <Compile Remove="Combats\CombatFactoryTests.cs" />
    <Compile Remove="Combats\CombatHoldTickTests.cs" />
    <Compile Remove="Combats\CombatInstanceTests.cs" />
    <Compile Remove="Combats\CombatMultiEnemyFlowTests.cs" />
    <Compile Remove="Combats\CombatTests.cs" />
    <Compile Remove="Combats\CombatantTests.cs" />
    <Compile Remove="Combats\Effects\CombatSkillEffectResolver*.cs" />
    <Compile Remove="Combats\Typing\CombatSkillEffectResolverTypingTests.cs" />
    <Compile Remove="Combats\Resolution\CombatResolutionServiceTests.cs" />
    <Compile Remove="Combats\EnemyTurns\*BehaviorsTests.cs" />
    <Compile Remove="Combats\EnemyTurns\BossBehaviorTests.cs" />
    <Compile Remove="Combats\EnemyTurns\ImperatriceDeLaFalaiseBehaviorTests.cs" />
    <Compile Remove="Runs\Reposition\**\*.cs" />
    <Compile Remove="Runs\UseCombatSkill\**\*.cs" />
    <Compile Remove="Runs\RunCombatCompletionTests.cs" />
    <Compile Remove="Runs\RunCombatTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Events\ResolveNodeEvent\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
